# 统一换行符, 避免跨平台无谓 diff
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.spec  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf
*.il    text eol=lf
*.manifest text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.ico   binary
*.png   binary
*.jpg   binary
*.xlsx  binary
*.brd   binary
*.pdf   binary
